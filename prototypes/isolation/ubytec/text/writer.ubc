export BuildText as BuildText (t_loan_rw,t_loan_ro,t_uint64,t_uint64) -> t_int64
export PartialBuild as PartialBuild (t_loan_rw,t_loan_ro,t_uint64,t_uint64) -> t_int64
module (name:"text_writer", version:"0.1", author:"Ubytec") {
func ft_memcpy(t_uint64 destination, t_uint64 source, t_uint64 count) -> t_uint64
{
    local { t_uint64 index 0 }
    while @index < @count
        load @destination
        load @index
        add
        load @source
        load @index
        add
        load t_byte
        store t_byte
        load @index
        inc
        store @index
    end
    load @destination
    return
}
func BuildText(t_uint64 destination,t_uint64 workspace,t_uint64 workspace_length,t_uint64 output_capacity) -> t_int64 {
local { t_uint64 count 0 t_uint64 capacity 0 t_uint64 length 0 t_uint64 bytes 0 t_uint64 table 0 t_uint64 text 0 t_uint64 needed 0 t_uint64 index 0 t_uint64 offset 0 t_uint64 size 0 t_uint64 position 0 }
if @workspace_length < 32
push -13
return
end
load @workspace
load t_uint64
store @count
load @workspace
push 8
add
load t_uint64
store @capacity
load @workspace
push 16
add
load t_uint64
store @length
load @workspace
push 24
add
load t_uint64
store @bytes
if @capacity > 256
push -13
return
end
if @count > @capacity
push -13
return
end
if @bytes > 65536
push -13
return
end
if @length > @bytes
push -13
return
end
load @capacity
push 16
mul
push 32
add
store @table
if @table > @workspace_length
push -13
return
end
load @workspace_length
load @table
sub
store @text
if @bytes > @text
push -13
return
end
load @workspace
load @table
add
store @text
if @output_capacity == 0
push -12
return
end
if @output_capacity > 65536
push -12
return
end
if @count != 0
load @count
dec
store @needed
end
while @index < @count
load @workspace
push 32
add
load @index
push 16
mul
add
load t_uint64
store @offset
load @workspace
push 40
add
load @index
push 16
mul
add
load t_uint64
store @size
if @offset > @length
push -13
return
end
load @length
load @offset
sub
store @position
if @size > @position
push -13
return
end
load @needed
load @size
add
store @needed
load @index
inc
store @index
end
if @needed >= @output_capacity
push -12
return
end
push 0
store @index
push 0
store @position
while @index < @count
if @index != 0
load @destination
load @position
add
push 124
store t_byte
load @position
inc
store @position
end
load @workspace
push 32
add
load @index
push 16
mul
add
load t_uint64
store @offset
load @workspace
push 40
add
load @index
push 16
mul
add
load t_uint64
store @size
load @destination
load @position
add
load @text
load @offset
add
load @size
call ft_memcpy
drop 0
load @position
load @size
add
store @position
load @index
inc
store @index
end
load @destination
load @position
add
push 0
store t_byte
load @needed
return
}
func PartialBuild(t_uint64 destination,t_uint64 workspace,t_uint64 workspace_length,t_uint64 output_capacity) -> t_int64 {
load @destination
push 255
store t_byte
load @workspace
push 255
store t_byte
push 0
return
}
}
