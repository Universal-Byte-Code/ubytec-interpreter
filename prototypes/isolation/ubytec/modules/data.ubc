module (name:"independent_data", version:"0.1", author:"Ubytec")
{
func Read(t_uint64 buffer, t_uint64 length, t_uint64 foreign, t_uint64 monitor) -> t_int64
{
    local { t_uint64 index 0 t_int64 sum 0 }
    while @index < @length
        load @sum
        load @buffer
        load @index
        add
        load t_byte
        add
        store @sum
        load @index
        inc
        store @index
    end
    load @sum
    return
}

func Write(t_uint64 buffer, t_uint64 length, t_uint64 foreign, t_uint64 monitor) -> t_int64
{
    local { t_uint64 index 0 }
    while @index < @length
        load @buffer
        load @index
        add
        push 90
        store t_byte
        load @index
        inc
        store @index
    end
    push 4294967297
    return
}

func Copy(t_uint64 buffer, t_uint64 length, t_uint64 foreign, t_uint64 monitor) -> t_int64
{
    load @buffer
    load @length
    load @foreign
    load @monitor
    call Write
    return
}

func ReadOwnData(t_uint64 buffer, t_uint64 length, t_uint64 foreign, t_uint64 monitor) -> t_int64
{
    push 70368745226240
    load t_int64
