}
func TailSelf(t_uint64 buffer, t_uint64 length, t_uint64 foreign, t_uint64 monitor) -> t_int64
{
    push 200000
    push 0
    push 0
    push 0
    call Accumulate
    return
}
func Accumulate(t_int64 n, t_int64 acc, t_int64 unused, t_int64 extra) -> t_int64
{
    local { t_int64 step 7 }
    if @n == 0
        load @acc
        return
    end
    load @n
    dec
    load @acc
    load @step
    add
    load @unused
    load @extra
    call Accumulate
    return
}
func TailMutual(t_uint64 buffer, t_uint64 length, t_uint64 foreign, t_uint64 monitor) -> t_int64
{
    push 200000
    push 0
    push 7
    push 9
    call Alternate
