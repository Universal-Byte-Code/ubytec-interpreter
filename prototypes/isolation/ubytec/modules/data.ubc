}
func Alternate(t_int64 n, t_int64 acc, t_int64 left, t_int64 right) -> t_int64
{
    if @n == 0
        load @acc
        return
    end
    load @n
    dec
    load @acc
    inc
    load @right
    load @left
    call Other
