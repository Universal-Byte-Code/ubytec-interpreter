import ReadLength from strings.Length (t_uint64,t_uint64,t_uint64,t_uint64) -> t_int64
import CopyMemory from memory.Copy (t_uint64,t_uint64,t_uint64,t_uint64) -> t_int64
import CopyHidden from memory.Copy (t_uint64,t_uint64,t_uint64,t_uint64) -> t_int64
import EscapeMemory from memory.Escape (t_uint64,t_uint64,t_uint64,t_uint64) -> t_int64
