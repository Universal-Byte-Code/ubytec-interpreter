export Touch as Touch (t_loan_rw,t_uint64) -> t_int64
export HeaderAttack as HeaderAttack (t_loan_rw,t_uint64) -> t_int64
export Escape as Escape (t_loan_rw,t_uint64) -> t_int64
export Spin as Spin (t_loan_rw,t_uint64) -> t_int64
export Negative as Negative (t_loan_rw,t_uint64) -> t_int64
export ReadOnly as ReadOnly (t_loan_ro,t_uint64) -> t_int64
module (name:"arena_receiver",version:"0.1",author:"Ubytec") {
func Touch(t_uint64 pointer,t_uint64 count) -> t_int64 {
load @pointer
push 34
store t_byte
load @count
return
}
func HeaderAttack(t_uint64 pointer,t_uint64 count) -> t_int64 {
load @pointer
push 34
store t_byte
load @pointer
push 32
sub
push 255
store t_byte
load @count
return
}
func Escape(t_uint64 pointer,t_uint64 count) -> t_int64 {
load @pointer
push 34
store t_byte
load @pointer
push 65536
add
push 255
store t_byte
load @count
return
}
func Spin(t_uint64 pointer,t_uint64 count) -> t_int64 {
load @pointer
push 34
store t_byte
loop
end
}
func Negative(t_uint64 pointer,t_uint64 count) -> t_int64 {
load @pointer
push 51
store t_byte
push -77
return
}
func ReadOnly(t_uint64 pointer,t_uint64 count) -> t_int64 {
load @pointer
push 34
store t_byte
load @count
return
}
}
