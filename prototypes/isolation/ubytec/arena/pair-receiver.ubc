func Copy(t_uint64 dst,t_uint64 src,t_uint64 count) -> t_int64 {
local { t_uint64 i 0 }
while @i < @count
load @dst
load @i
add
load @src
load @i
add
load t_byte
store t_byte
load @i
push 1
add
store @i
end
load @count
return
}
