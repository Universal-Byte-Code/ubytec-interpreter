func TextWrite(t_uint64 resource,t_uint64 data,t_uint64 length,t_uint64 resultcell,t_uint64 offsetcell) -> t_uint64 {
local { t_uint64 cursor 0 t_uint64 size 0 t_uint64 offset 0 t_uint64 status 0 t_uint64 count 0 }
