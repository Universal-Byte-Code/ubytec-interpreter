module (name:"libft_arena_strings",version:"0.1",author:"Ubytec") {
func ft_strdup_arena(t_uint64 arena,t_uint64 source) -> t_uint64 {
local { t_uint64 length 0 t_uint64 destination 0 t_uint64 ignored 0 }
