module (name:"temporal_scalar",version:"0.1",author:"Ubytec")
{
    func TemporalIsUnary(t_uint64 op) -> t_uint64
    {
        load @op
        push 37
        uge
        load @op
        push 40
        ule
        and
        load @op
        push 51
        eq
        or
        return
    }

    func TemporalIsBinary(t_uint64 op) -> t_uint64
    {
        // Contiguous assigned registry ranges, excluding unary operations.
        load @op
        push 32
        uge
        load @op
        push 36
        ule
        and
        load @op
        push 41
        eq
        or
        load @op
        push 42
        eq
        or
        load @op
        push 48
        uge
        load @op
        push 50
        ule
        and
        or
        load @op
        push 52
        uge
        load @op
        push 54
        ule
        and
        or
        load @op
        push 64
        uge
        load @op
        push 73
        ule
        and
        or
        return
    }

    func TemporalArithmeticSafe(t_uint64 op,t_uint64 lhs,t_uint64 rhs) -> t_uint64
    {
        load @op
        push 35
        eq
        load @op
        push 36
        eq
        or
        if
            if @rhs == 0
                push 0
                return
            end
            load @lhs
            push 1
            push 63
            shl
            eq
            load @rhs
            push 0
            not
            eq
            and
            if
                push 0
                return
            end
        end
        load @op
        push 41
        eq
        load @op
        push 42
        eq
        or
        if
            if @rhs == 0
                push 0
                return
            end
        end
        push 1
        return
    }

    func TemporalUnary(t_uint64 op,t_uint64 value) -> t_uint64
    {
        load @op
        switch
            branch 37
                load @value
                inc
                return
            end
            branch 38
                load @value
                dec
                return
            end
            branch 39
                load @value
                neg
                return
            end
            branch 40
                load @value
                abs
                return
            end
            branch 51
                load @value
                not
                return
            end
            default
                trap
        end
    }

    // Opcode registry values are localized here. Each branch implements exactly
    // one cell transformation; the caller owns admission, fuel and fault checks.
    func TemporalBinary(t_uint64 op,t_uint64 lhs,t_uint64 rhs) -> t_uint64
    {
        load @op
        switch
            branch 32
                load @lhs
                load @rhs
                add
                return
            end
            branch 33
                load @lhs
                load @rhs
                sub
                return
            end
            branch 34
                load @lhs
                load @rhs
                mul
                return
            end
            branch 35
                load @lhs
                load @rhs
                div
                return
            end
            branch 36
                load @lhs
                load @rhs
                mod
                return
            end
            branch 41
                load @lhs
                load @rhs
                udiv
                return
            end
            branch 42
                load @lhs
                load @rhs
                umod
                return
            end
            branch 48
                load @lhs
                load @rhs
                and
                return
            end
            branch 49
                load @lhs
                load @rhs
                or
                return
            end
            branch 50
                load @lhs
                load @rhs
                xor
                return
            end
            branch 52
                load @lhs
                load @rhs
                shl
                return
            end
            branch 53
                load @lhs
                load @rhs
                shr
                return
            end
            branch 54
                load @lhs
                load @rhs
                lshr
                return
            end
            branch 64
                load @lhs
                load @rhs
                eq
                return
            end
            branch 65
                load @lhs
                load @rhs
                neq
                return
            end
            branch 66
                load @lhs
                load @rhs
                lt
                return
            end
            branch 67
                load @lhs
                load @rhs
                le
                return
            end
            branch 68
                load @lhs
                load @rhs
                gt
                return
            end
            branch 69
                load @lhs
                load @rhs
                ge
                return
            end
            branch 70
                load @lhs
                load @rhs
                ult
                return
            end
            branch 71
                load @lhs
                load @rhs
                ule
                return
            end
            branch 72
                load @lhs
                load @rhs
                ugt
                return
            end
            branch 73
                load @lhs
                load @rhs
                uge
                return
            end
            default
                trap
        end
    }
}
