module (name:"temporal_runtime",version:"0.1",author:"Ubytec")
{
    // Execute one admitted turn. The plan owns instruction framing and operands;
    // guest fuel counts plan entries, not the native instructions implementing them.
    func TemporalTurn(t_uint64 count,t_uint64 state,t_uint64 cells,t_uint64 capacity,t_uint64 quantum,t_uint64 plan) -> t_uint64
    {
        local
        {
            t_uint64 pc 0 t_uint64 depth 0 t_uint64 fuel 0 t_uint64 phase 0
            t_uint64 site 0 t_uint64 charged 0 t_uint64 op 0 t_uint64 operand 0
            t_uint64 row 0 t_uint64 target 0 t_uint64 shape 0 t_uint64 status 0
        }
        if @quantum == 0
            push 6
            return
        end
        load @capacity
        push 4096
        ugt
        if
            push 6
            return
        end
        load @state
        push 3
        call TemporalCellGet
        store @phase
        load @phase
        switch
            branch 0
                // Pending entry becomes runnable; entry itself costs no fuel.
                load @state
                push 1
                push 0
                call TemporalSetPhase
                return
            end
            branch 2
                load @state
                push 5
                push 5
                call TemporalSetPhase
                return
            end
            branch 3
                load @state
                push 4
                push 4
                call TemporalSetPhase
                return
            end
            branch 4
                load @state
                push 5
                push 5
                call TemporalSetPhase
                return
            end
            branch 1
                // Runnable.
                nop
            end
            default
                push 6
                return
        end
        load @state
        push 0
        call TemporalCellGet
        store @pc
        load @state
        push 1
        call TemporalCellGet
        store @depth
        load @state
        push 2
        call TemporalCellGet
        store @fuel
        loop
            load @pc
            load @count
            uge
            if
                load @state
                call TemporalFail
                return
            end
            load @fuel
            inc
            if
            else
                load @state
                call TemporalFail
                return
            end
            load @pc
            store @site
            load @plan
            load @site
            call TemporalPlanRow
            store @row
            // PC is an internal ordinal; ledger identity is the wire offset.
            load @row
            push 8
            call TemporalPlanGet
            store @site
            // The admitted stack depth is a cheap runtime invariant.
            load @row
            push 5
            call TemporalPlanGet
            load @depth
            inc
            neq
            if
                load @state
                call TemporalFail
                return
            end
            load @row
            push 0
            call TemporalPlanGet
            store @op
            load @row
            push 1
            call TemporalPlanGet
            store @pc
            load @row
            push 2
            call TemporalPlanGet
            store @target
            load @row
            push 6
            call TemporalPlanGet
            store @operand
            load @fuel
            inc
            store @fuel
            load @charged
            inc
            store @charged
            load @op
            switch
                branch 0
                    // TRAP
                    load @state
                    load @pc
                    load @depth
                    load @fuel
                    load @site
                    push 3
                    call TemporalSaveBoundary
                    return
                end
                branch 1
                    // NOP
                    nop
                end
                branch 2
                    // Untyped BLOCK
                    nop
                end
                branch 3
                    // LOOP
                    nop
                end
                branch 4
                    // IF
                    load @cells
                    load @depth
                    call TemporalCondition
                    if
                    else
                        load @target
                        store @pc
                    end
                    load @depth
                    dec
                    store @depth
                end
                branch 5
                    // ELSE
                    load @target
                    store @pc
                end
                branch 6
                    // END
                    load @target
                    store @pc
                end
                branch 7
                    // BREAK
                    load @target
                    store @pc
                end
                branch 8
                    // CONTINUE
                    load @target
                    store @pc
                end
                branch 9
                    // RETURN
                    load @depth
                    dec
                    store @depth
                    load @state
                    push 5
                    load @cells
                    load @depth
                    call TemporalCellGet
                    call TemporalCellSet
                    load @state
                    load @pc
                    load @depth
                    load @fuel
                    load @site
                    push 2
                    call TemporalSaveBoundary
                    return
                end
                branch 12
                    // WHILE
                    load @cells
                    load @depth
                    call TemporalCondition
                    if
                    else
                        load @target
                        store @pc
                    end
                    load @depth
                    dec
                    store @depth
                end
                branch 17
                    // PUSH: immediate already decoded by admission.
                    load @cells
                    load @depth
                    load @operand
                    call TemporalCellSet
                    load @depth
                    inc
                    store @depth
                end
                default
                    load @op
                    load @operand
                    load @depth
                    load @capacity
                    call TemporalPrivateDepth
                    store @shape
                    if @shape == 0
                        load @state
                        call TemporalFail
                        return
                    end
                    load @cells
                    load @depth
                    load @op
                    load @operand
                    call TemporalPrivateApply
                    store @status
                    if @status == 2
                        load @state
                        load @pc
                        load @depth
                        load @fuel
                        load @site
                        push 3
                        call TemporalSaveBoundary
                        return
                    end
                    if @status != 1
                        load @state
                        call TemporalFail
                        return
                    end
                    load @shape
                    dec
                    store @depth
            end
            if @charged == @quantum
                load @state
                load @pc
                load @depth
                load @fuel
                load @site
                push 1
                call TemporalSaveBoundary
                return
            end
        end
    }

    // Serial reference scheduler. Each context occupies eight cells (six state
    // fields plus local sequence and Lamport clock). Ledger row has nine cells:
    // round, context ordinal, sequence, logical time, commit, kind, fuel,
    // last instruction offset (NoIndex for synthetic boundaries), result.
    // Kind 7 is coordinator context creation. Initial creation causality makes
    // context i's first logical clock i+1. Return 0 means infrastructure failure.
    // The host supplies non-overlapping sized buffers; no guest physical addresses.
    func TemporalRun(t_uint64 code,t_uint64 length,t_uint64 states,t_uint64 stacks,t_uint64 contexts,t_uint64 capacity,t_uint64 quantum,t_uint64 ledger,t_uint64 limit,t_uint64 plan) -> t_uint64
    {
        load @code
        load @length
        load @capacity
        load @plan
        call TemporalPlanPrepare
        if
        else
            push 0
            return
        end
        load @states
        load @stacks
        load @contexts
        load @capacity
        load @quantum
        load @ledger
        load @limit
        load @plan
        call TemporalRunPrepared
        return
    }

    // Verify the executable projection for the deliberately narrow bootstrap profile.
    // Returns 1 on success; writes (Code pointer, Code length) only after admission.
    // AST JSON is opaque and never executed. No manifests or imports are admitted.
    // All pointer arithmetic uses host-owned, immutable, contiguous input bytes.
    func TemporalAdmit(t_uint64 image,t_uint64 length,t_uint64 capacity,t_uint64 view,t_uint64 plan) -> t_uint64
    {
        local
        {
            t_uint64 cursor 12 t_uint64 count 0 t_uint64 index 0 t_uint64 previous 0
            t_uint64 header 0 t_uint64 kind 0 t_uint64 flags 0 t_uint64 size 0 t_uint64 payload 0
            t_uint64 seen 0 t_uint64 types 0 t_uint64 typesize 0 t_uint64 functions 0
            t_uint64 code 0 t_uint64 codesize 0
        }
        load @length
        push 12
        ult
        if
            push 0
            return
        end
        load @length
        push 67108864
        ugt
        if
            push 0
            return
        end
        load @image
        push 0
        add
        load t_uint32
        push 1296253525
        neq
        if
            push 0
            return
        end
        load @image
        push 4
        add
        load t_uint32
        push 0
        neq
        if
            push 0
            return
        end
        load @image
        push 8
        add
        load t_uint32
        store @count
        if @count == 0
            push 0
            return
        end
        if @count > 32
            push 0
            return
        end
        while @index < @count
            load @length
            load @cursor
            sub
            push 12
            ult
            if
                push 0
                return
            end
            load @image
            load @cursor
            add
            store @header
            load @header
            push 0
            add
            load t_uint16
            store @kind
            load @header
            push 2
            add
            load t_uint16
            store @flags
            load @header
            push 4
            add
            load t_uint64
            store @size
            load @kind
            load @previous
            ule
            if
                push 0
                return
            end
            load @kind
            store @previous
            if @flags > 1
                push 0
                return
            end
            load @cursor
            push 12
            add
            store @cursor
            load @size
            load @length
            load @cursor
            sub
            ugt
            if
                push 0
                return
            end
            load @image
            load @cursor
            add
            store @payload
            load @kind
            load @flags
            load @payload
            load @size
            call TemporalValidateSection
            if
            else
                push 0
                return
            end
            // Collect only the tables needed by the current execution profile.
            load @kind
            switch
                branch 1
                    load @seen
                    push 1
                    or
                    store @seen
                end
                branch 17
                    load @payload
                    store @types
                    load @size
                    store @typesize
                end
                branch 18
                    load @payload
                    store @functions
                end
                branch 22
                    load @payload
                    store @code
                    load @size
                    store @codesize
                end
            end
            load @kind
            call TemporalIndexedSection
            if
                load @seen
                push 1
                load @kind
                push 15
                sub
                shl
                or
                store @seen
            end
            load @cursor
            load @size
            add
            store @cursor
            load @index
            inc
            store @index
        end
        if @cursor != @length
            push 0
            return
        end
        // Bits 0..7 and 9 represent AST and all eight executable sections.
        if @seen != 767
            push 0
            return
        end
        load @types
        load @typesize
        load @functions
        load @codesize
        call TemporalValidateRootSignature
        if
        else
            push 0
            return
        end
        load @code
        load @codesize
        load @capacity
        load @plan
        call TemporalPlanPrepare
        if
        else
            push 0
            return
        end
        load @view
        load @code
        store t_uint64
        load @view
        push 8
        add
        load @codesize
        store t_uint64
        push 1
        return
    }

    // Public bootstrap entry: complete PMF bytes, not a pre-extracted Code segment.
    func TemporalRunModule(t_uint64 image,t_uint64 length,t_uint64 states,t_uint64 stacks,t_uint64 contexts,t_uint64 capacity,t_uint64 quantum,t_uint64 ledger,t_uint64 limit,t_uint64 plan,t_uint64 view) -> t_uint64
    {
        load @image
        load @length
        load @capacity
        load @view
        load @plan
        call TemporalAdmit
        if
        else
            push 0
            return
        end
        load @states
        load @stacks
        load @contexts
        load @capacity
        load @quantum
        load @ledger
        load @limit
        load @plan
        call TemporalRunPrepared
        return
    }
    // Section framing is checked by the caller before any of these payload reads.
    func TemporalIndexedSection(t_uint64 kind) -> t_uint64
    {
        load @kind
        push 16
        uge
        load @kind
        push 22
        ule
        and
        load @kind
        push 24
        eq
        or
        return
    }

    func TemporalReadU32(t_uint64 address,t_uint64 offset) -> t_uint64
    {
        load @address
        load @offset
        add
        load t_uint32
        return
    }

    func TemporalEmptyTable(t_uint64 payload,t_uint64 size) -> t_uint64
    {
        if @size != 4
            push 0
            return
        end
        load @payload
        push 0
        call TemporalReadU32
        push 0
        eq
        return
    }

    func TemporalValidateFunctionTable(t_uint64 payload,t_uint64 size) -> t_uint64
    {
        // One root function, no arguments, locals or flags, Code offset zero.
        if @size != 28
            push 0
            return
        end
        load @payload
        push 0
        call TemporalReadU32
        push 1
        eq
        load @payload
        push 8
        call TemporalReadU32
        push 0
        eq
        and
        load @payload
        push 12
        call TemporalReadU32
        push 0
        eq
        and
        load @payload
        push 16
        call TemporalReadU32
        push 0
        eq
        and
        load @payload
        push 24
        call TemporalReadU32
        push 0
        eq
        and
        return
    }

    func TemporalValidateContextTable(t_uint64 payload,t_uint64 size) -> t_uint64
    {
        // Context wire v3, DirectOnly, one root, no parent.
        if @size != 16
            push 0
            return
        end
        load @payload
        push 0
        call TemporalReadU32
        push 3
        eq
        load @payload
        push 4
        call TemporalReadU32
        push 1
        eq
        and
        load @payload
        push 8
        call TemporalReadU32
        push 1
        eq
        and
        load @payload
        push 12
        call TemporalReadU32
        push 4294967295
        eq
        and
        return
    }

    func TemporalValidateEntry(t_uint64 payload,t_uint64 size) -> t_uint64
    {
        if @size != 4
            push 0
            return
        end
        load @payload
        push 0
        call TemporalReadU32
        dup
        push 0
        eq
        swap
        push 4294967295
        eq
        or
        return
    }

    // Apply the restricted execution profile without mixing it with PMF traversal.
    func TemporalValidateSection(t_uint64 kind,t_uint64 flags,t_uint64 payload,t_uint64 size) -> t_uint64
    {
        load @kind
        call TemporalIndexedSection
        if
            if @flags != 1
                push 0
                return
            end
        end
        load @kind
        switch
            branch 1
                // Opaque, nonempty critical AST.
                load @flags
                push 1
                eq
                load @size
                push 0
                neq
                and
                return
            end
            branch 2
                // No contract manifest in this profile.
                push 0
                return
            end
            branch 3
                // No capability manifest.
                push 0
                return
            end
            branch 16
                // String table.
                load @payload
                load @size
                call TemporalEmptyTable
                return
            end
            branch 17
                // Type table: full root signature checked after traversal.
                load @size
                push 29
                uge
                return
            end
            branch 18
                load @payload
                load @size
                call TemporalValidateFunctionTable
                return
            end
            branch 19
                // Imports.
                load @payload
                load @size
                call TemporalEmptyTable
                return
            end
            branch 20
                // Exports.
                load @payload
                load @size
                call TemporalEmptyTable
                return
            end
            branch 21
                // Constants.
                load @payload
                load @size
                call TemporalEmptyTable
                return
            end
            branch 22
                // Code: framed and analyzed by TemporalPlanPrepare.
                push 1
                return
            end
            branch 23
                if @flags != 0
                    push 0
                    return
                end
                load @payload
                load @size
                call TemporalValidateEntry
                return
            end
            branch 24
                load @payload
                load @size
                call TemporalValidateContextTable
                return
            end
            branch 25
                // Callable slots require a different execution profile.
                push 0
                return
            end
            default
                // Unknown sections are accepted only when noncritical.
                load @flags
                push 0
                eq
                return
        end
    }

    func TemporalValidateRootSignature(t_uint64 types,t_uint64 typesize,t_uint64 functions,t_uint64 codesize) -> t_uint64
    {
        local
        {
            t_uint64 resulttype 0 t_uint64 typecount 0 t_uint64 typeptr 0
        }
        load @types
        push 0
        add
        load t_uint32
        store @typecount
        if @typecount == 0
            push 0
            return
        end
        load @typecount
        push 25
        mul
        push 4
        add
        load @typesize
        neq
        if
            push 0
            return
        end
        load @functions
        push 4
        add
        load t_uint32
        store @resulttype
        load @resulttype
        load @typecount
        uge
        if
            push 0
            return
        end
        load @types
        push 4
        add
        load @resulttype
        push 25
        mul
        add
        store @typeptr
        load @typeptr
        push 0
        add
        load t_byte
        push 11
        neq
        if
            push 0
            return
        end
        load @typeptr
        push 1
        add
        load t_uint32
        push 0
        neq
        if
            push 0
            return
        end
        load @typeptr
        push 5
        add
        load t_uint64
        push 1
        neq
        if
            push 0
            return
        end
        load @typeptr
        push 13
        add
        load t_uint32
        push 4294967295
        neq
        if
            push 0
            return
        end
        load @typeptr
        push 17
        add
        load t_uint64
        push 0
        neq
        if
            push 0
            return
        end
        load @functions
        push 20
        add
        load t_uint32
        load @codesize
        neq
        if
            push 0
            return
        end
        push 1
        return
    }

    // Returns new depth + 1, or zero. Internal opcode 273 denotes escaped PUSH16.
    func TemporalPrivateDepth(t_uint64 op,t_uint64 idx,t_uint64 depth,t_uint64 capacity) -> t_uint64
    {
        local
        {
            t_uint64 required 0
            t_uint64 produced 0
        }
        // Scalar operators consume one or two cells and produce one.
        load @op
        call TemporalIsUnary
        if
            load @depth
            load @capacity
            push 1
            push 1
            call TemporalDepthShape
            return
        end
        load @op
        call TemporalIsBinary
        if
            load @depth
            load @capacity
            push 2
            push 1
            call TemporalDepthShape
            return
        end
        // Stack contracts describe a top window: how many cells are needed
        // and how many occupy that window after the operation.
        load @op
        switch
            branch 13
                // CLEAR
                push 1
                return
            end
            branch 15
                // NULL: 0 -> 1
                push 1
                store @produced
            end
            branch 18
                // POP: 1 -> 0
                push 1
                store @required
            end
            branch 19
                // DUP: 1 -> 2
                push 1
                store @required
                push 2
                store @produced
            end
            branch 20
                // SWAP: 2 -> 2
                push 2
                dup
                store @required
                store @produced
            end
            branch 21
                // ROT: 3 -> 3
                push 3
                dup
                store @required
                store @produced
            end
            branch 22
                // OVER: 2 -> 3
                push 2
                store @required
                push 3
                store @produced
            end
            branch 23
                // NIP: 2 -> 1
                push 2
                store @required
                push 1
                store @produced
            end
            branch 24
                // DROP / DROP16
                load @idx
                inc
                store @required
                load @idx
                store @produced
            end
            branch 25
                // 2DUP: 2 -> 4
                push 2
                store @required
                push 4
                store @produced
            end
            branch 26
                // 2SWAP: 4 -> 4
                push 4
                dup
                store @required
                store @produced
            end
            branch 27
                // 2ROT: 6 -> 6
                push 6
                dup
                store @required
                store @produced
            end
            branch 28
                // 2OVER: 4 -> 6
                push 4
                store @required
                push 6
                store @produced
            end
            branch 29
                // PICK / PICK16
                load @idx
                inc
                dup
                store @required
                inc
                store @produced
            end
            branch 30
                // ROLL / ROLL16
                load @idx
                inc
                dup
                store @required
                store @produced
            end
            branch 273
                // PUSH16 reads two bytes, potentially across a cell boundary.
                load @idx
                inc
                push 8
                udiv
                inc
                dup
                store @required
                inc
                store @produced
            end
            default
                push 0
                return
        end
        load @depth
        load @capacity
        load @required
        load @produced
        call TemporalDepthShape
        return
    }

    // A result of zero rejects the shape; otherwise return next depth + 1.
    // Subtract only after proving the top window is present.
    func TemporalDepthShape(t_uint64 depth,t_uint64 capacity,t_uint64 required,t_uint64 produced) -> t_uint64
    {
        local
        {
            t_uint64 nextdepth 0
        }
        load @depth
        load @required
        ult
        if
            push 0
            return
        end
        load @produced
        load @depth
        load @required
        block (t_uint64,t_uint64,t_uint64) -> t_uint64
            sub
            add
        end
        store @nextdepth
        load @nextdepth
        load @capacity
        ugt
        if
            push 0
            return
        end
        load @nextdepth
        inc
        return
    }

    func TemporalIsBinary(t_uint64 op) -> t_uint64
    {
        // Contiguous assigned registry ranges, excluding unary operations.
        load @op
        push 32
        uge
        load @op
        push 36
        ule
        and
        load @op
        push 41
        eq
        or
        load @op
        push 42
        eq
        or
        load @op
        push 48
        uge
        load @op
        push 50
        ule
        and
        or
        load @op
        push 52
        uge
        load @op
        push 54
        ule
        and
        or
        load @op
        push 64
        uge
        load @op
        push 73
        ule
        and
        or
        return
    }

    // Private transformations. Admission and turn dispatch both enforce the
    // stack shape first. 1 = success, 2 = arithmetic trap, 0 = invariant failure.
    func TemporalPrivateApply(t_uint64 cells,t_uint64 depth,t_uint64 op,t_uint64 idx) -> t_uint64
    {
        local
        {
            t_uint64 lhs 0 t_uint64 rhs 0
        }
        load @op
        switch
            branch 13
                // CLEAR changes depth only.
                nop
            end
            branch 15
                // NULL
                load @cells
                load @depth
                push 0
                call TemporalCellSet
            end
            branch 18
                // POP changes depth only.
                nop
            end
            branch 19
                // DUP
                load @cells
                load @depth
                push 0
                call TemporalPick
            end
            branch 20
                // SWAP
                load @cells
                load @depth
                push 2
                push 1
                call TemporalRotate
            end
            branch 21
                // ROT
                load @cells
                load @depth
                push 3
                push 1
                call TemporalRotate
            end
            branch 22
                // OVER
                load @cells
                load @depth
                push 1
                call TemporalPick
            end
            branch 23
                // NIP
                load @cells
                load @depth
                push 1
                call TemporalRemove
            end
            branch 24
                // DROP / DROP16
                load @cells
                load @depth
                load @idx
                call TemporalRemove
            end
            branch 25
                // 2DUP
                load @cells
                load @depth
                push 2
                call TemporalCopyPair
            end
            branch 26
                // 2SWAP
                load @cells
                load @depth
                push 4
                push 2
                call TemporalRotate
            end
            branch 27
                // 2ROT
                load @cells
                load @depth
                push 6
                push 2
                call TemporalRotate
            end
            branch 28
                // 2OVER
                load @cells
                load @depth
                push 4
                call TemporalCopyPair
            end
            branch 29
                // PICK / PICK16
                load @cells
                load @depth
                load @idx
                call TemporalPick
            end
            branch 30
                // ROLL / ROLL16
                load @cells
                load @depth
                load @idx
                inc
                push 1
                call TemporalRotate
            end
            branch 273
                // PUSH16: word at byte offset in top-first stack representation.
                load @cells
                load @depth
                load @cells
                load @depth
                load @idx
                call TemporalStackWord
                call TemporalCellSet
            end
            default
                load @cells
                load @depth
                push 0
                call TemporalStackGet
                store @rhs
                load @op
                call TemporalIsUnary
                if
                    load @cells
                    load @depth
                    dec
                    load @op
                    load @rhs
                    call TemporalUnary
                    call TemporalCellSet
                else
                    load @cells
                    load @depth
                    push 1
                    call TemporalStackGet
                    store @lhs
                    load @op
                    load @lhs
                    load @rhs
                    call TemporalArithmeticSafe
                    if
                    else
                        push 2
                        return
                    end
                    load @cells
                    load @depth
                    push 2
                    sub
                    load @op
                    load @lhs
                    load @rhs
                    call TemporalBinary
                    call TemporalCellSet
                end
        end
        push 1
        return
    }

    // Count header, 24-byte instruction records, u16 work queue.
    // Execution links use ordinals; event identity uses the original byte offset.
    func TemporalPlanEdge(t_uint64 plan,t_uint64 work,t_uint64 length,t_uint64 tail,t_uint64 dest,t_uint64 depth) -> t_uint64
    {
        local
        {
            t_uint64 row 0 t_uint64 seen 0
        }
        load @dest
        load @length
        uge
        if
            push 0
            return
        end
        load @plan
        load @dest
        call TemporalPlanRow
        store @row
        load @row
        push 5
        call TemporalPlanGet
        store @seen
        if @seen == 0
            load @tail
            load @length
            uge
            if
                push 0
                return
            end
            load @row
            push 5
            load @depth
            inc
            call TemporalPlanSet
            load @work
            load @tail
            push 2
            mul
            add
            load @dest
            store t_uint16
            load @tail
            inc
            store @tail
        else
            load @seen
            load @depth
            inc
            neq
            if
                push 0
                return
            end
        end
        load @tail
        inc
        return
    }

    // Admission pipeline: decode/lexical links, forward edges, dataflow, transfer contracts.
    func TemporalPlanPrepare(t_uint64 code,t_uint64 length,t_uint64 capacity,t_uint64 plan) -> t_uint64
    {
        local
        {
            t_uint64 count 0
        }
        if @length == 0
            push 0
            return
        end
        load @length
        push 4096
        ugt
        if
            push 0
            return
        end
        if @capacity == 0
            push 0
            return
        end
        load @capacity
        push 4096
        ugt
        if
            push 0
            return
        end
        load @plan
        push 0
        push 0
        call TemporalCellSet
        load @code
        load @length
        load @plan
        call TemporalLinkScopes
        if
        else
            push 0
            return
        end
        load @plan
        push 0
        call TemporalCellGet
        store @count
        load @count
        load @plan
        call TemporalResolveBreaks
        if
        else
            push 0
            return
        end
        load @count
        load @capacity
        load @plan
        call TemporalAnalyzeDepth
        if
        else
            push 0
            return
        end
        load @count
        load @plan
        call TemporalValidateTransfers
        return
    }

    func TemporalDecode(t_uint64 code,t_uint64 length,t_uint64 pc,t_uint64 row,t_uint64 site) -> t_uint64
    {
        local
        {
            t_uint64 op 0 t_uint64 idx 0 t_uint64 n 0
        }
        load @code
        load @pc
        add
        push 0
        add
        load t_byte
        store @op
        load @pc
        push 1
        add
        store @pc
        push 0
        store @idx
        // Decode operand-bearing instructions and only the admitted BLOCK mode.
        if @op == 17
            load @length
            load @pc
            sub
            push 1
            ult
            if
                push 0
                return
            end
            load @code
            load @pc
            add
            push 0
            add
            load t_byte
            store @idx
            load @pc
            push 1
            add
            store @pc
            if @idx == 0
                push 0
                return
            end
            if @idx > 8
                push 0
                return
            end
            load @idx
            load @length
            load @pc
            sub
            ugt
            if
                push 0
                return
            end
            load @code
            load @pc
            add
            load @idx
            call TemporalReadImmediate
            store @n
            load @pc
            load @idx
            add
            store @pc
            load @n
            store @idx
        else
            if @op == 255
                load @length
                load @pc
                sub
                push 4
                ult
                if
                    push 0
                    return
                end
                load @code
                load @pc
                add
                push 0
                add
                load t_byte
                push 16
                neq
                if
                    push 0
                    return
                end
                load @code
                load @pc
                add
                push 1
                add
                load t_byte
                store @op
                if @op == 17
                    push 273
                    store @op
                else
                    load @op
                    push 24
                    eq
                    load @op
                    push 29
                    eq
                    or
                    load @op
                    push 30
                    eq
                    or
                    if
                    else
                        push 0
                        return
                    end
                end
                load @code
                load @pc
                add
                push 2
                add
                load t_uint16
                store @idx
                load @pc
                push 4
                add
                store @pc
            else
                load @op
                push 24
                eq
                load @op
                push 29
                eq
                or
                load @op
                push 30
                eq
                or
                if
                    load @length
                    load @pc
                    sub
                    push 1
                    ult
                    if
                        push 0
                        return
                    end
                    load @code
                    load @pc
                    add
                    push 0
                    add
                    load t_byte
                    store @idx
                    load @pc
                    push 1
                    add
                    store @pc
                end
                load @op
                push 2
                eq
                load @op
                push 9
                eq
                or
                if
                    load @length
                    load @pc
                    sub
                    push 1
                    ult
                    if
                        push 0
                        return
                    end
                    load @code
                    load @pc
                    add
                    push 0
                    add
                    load t_byte
                    if
                        push 0
                        return
                    end
                    load @pc
                    push 1
                    add
                    store @pc
                end
                load @op
                push 7
                eq
                load @op
                push 8
                eq
                or
                if
                    load @length
                    load @pc
                    sub
                    push 4
                    ult
                    if
                        push 0
                        return
                    end
                    load @code
                    load @pc
                    add
                    push 0
                    add
                    load t_uint32
                    store @idx
                    load @pc
                    push 4
                    add
                    store @pc
                end
            end
        end
        // Record the normalized operation and ordinal successor.
        load @row
        push 0
        load @op
        call TemporalPlanSet
        load @row
        push 1
        load @site
        inc
        call TemporalPlanSet
        load @row
        push 2
        load @site
        inc
        call TemporalPlanSet
        load @row
        push 3
        push 0
        call TemporalPlanSet
        load @row
        push 4
        push 0
        call TemporalPlanSet
        load @row
        push 5
        push 0
        call TemporalPlanSet
        load @row
        push 6
        load @idx
        call TemporalPlanSet
        load @row
        push 7
        push 0
        call TemporalPlanSet
        load @pc
        return
    }

    func TemporalLinkScopes(t_uint64 code,t_uint64 length,t_uint64 plan) -> t_uint64
    {
        local
        {
            t_uint64 pc 0 t_uint64 site 0 t_uint64 row 0 t_uint64 op 0 t_uint64 idx 0
            t_uint64 top 0 t_uint64 scope 0 t_uint64 kind 0 t_uint64 alternate 0
            t_uint64 cursor 0 t_uint64 ordinal 0
        }
        while @pc < @length
            load @plan
            load @site
            call TemporalPlanRow
            store @row
            load @row
            push 8
            load @pc
            call TemporalPlanSet
            load @code
            load @length
            load @pc
            load @row
            load @site
            call TemporalDecode
            store @pc
            if @pc == 0
                push 0
                return
            end
            load @row
            push 0
            call TemporalPlanGet
            store @op
            load @row
            push 6
            call TemporalPlanGet
            store @idx
            load @op
            push 2
            eq
            load @op
            push 3
            eq
            or
            load @op
            push 4
            eq
            or
            load @op
            push 12
            eq
            or
            if
                load @row
                push 3
                load @top
                call TemporalPlanSet
                load @site
                inc
                store @top
            else
                if @op == 5
                    if @top == 0
                        push 0
                        return
                    end
                    load @plan
                    load @top
                    dec
                    call TemporalPlanRow
                    store @scope
                    load @scope
                    push 0
                    call TemporalPlanGet
                    push 4
                    neq
                    if
                        push 0
                        return
                    end
                    load @scope
                    push 4
                    call TemporalPlanGet
                    if
                        push 0
                        return
                    end
                    load @scope
                    push 4
                    load @site
                    inc
                    call TemporalPlanSet
                    load @scope
                    push 2
                    load @site
                    inc
                    call TemporalPlanSet
                else
                    if @op == 6
                        if @top == 0
                            push 0
                            return
                        end
                        load @plan
                        load @top
                        dec
                        call TemporalPlanRow
                        store @scope
                        load @scope
                        push 0
                        call TemporalPlanGet
                        store @kind
                        load @scope
                        push 3
                        call TemporalPlanGet
                        store @top
                        load @scope
                        push 7
                        load @site
                        inc
                        call TemporalPlanSet
                        if @kind == 3
                            load @row
                            push 2
                            load @scope
                            push 1
                            call TemporalPlanGet
                            call TemporalPlanSet
                        end
                        if @kind == 12
                            load @row
                            push 2
                            load @scope
                            load @plan
                            call TemporalPlanOrdinal
                            call TemporalPlanSet
                            load @scope
                            push 2
                            load @site
                            inc
                            call TemporalPlanSet
                        end
                        if @kind == 4
                            load @scope
                            push 4
                            call TemporalPlanGet
                            store @alternate
                            if @alternate == 0
                                load @scope
                                push 2
                                load @site
                                inc
                                call TemporalPlanSet
                            else
                                load @plan
                                load @alternate
                                dec
                                call TemporalPlanRow
                                store @scope
                                load @scope
                                push 2
                                load @site
                                inc
                                call TemporalPlanSet
                            end
                        end
                    else
                        load @op
                        push 7
                        eq
                        load @op
                        push 8
                        eq
                        or
                        if
                            load @top
                            store @cursor
                            load @idx
                            store @ordinal
                            loop
                                if @cursor == 0
                                    push 0
                                    return
                                end
                                load @plan
                                load @cursor
                                dec
                                call TemporalPlanRow
                                store @scope
                                load @scope
                                push 0
                                call TemporalPlanGet
                                store @kind
                                load @kind
                                push 3
                                eq
                                load @kind
                                push 12
                                eq
                                or
                                if
                                    if @ordinal == 0
                                        break
                                    end
                                    load @ordinal
                                    dec
                                    store @ordinal
                                end
                                load @scope
                                push 3
                                call TemporalPlanGet
                                store @cursor
                            end
                            load @row
                            push 3
                            load @cursor
                            call TemporalPlanSet
                            if @op == 8
                                if @kind == 3
                                    load @row
                                    push 2
                                    load @scope
                                    push 1
                                    call TemporalPlanGet
                                    call TemporalPlanSet
                                else
                                    load @row
                                    push 2
                                    load @cursor
                                    dec
                                    call TemporalPlanSet
                                end
                            end
                        else
                            load @op
                            push 0
                            eq
                            load @op
                            push 1
                            eq
                            or
                            load @op
                            push 9
                            eq
                            or
                            load @op
                            push 17
                            eq
                            or
                            if
                            else
                                // Reject unsupported private forms even on unreachable paths.
                                load @op
                                load @idx
                                push 65536
                                push 65538
                                call TemporalPrivateDepth
                                if
                                else
                                    push 0
                                    return
                                end
                            end
                        end
                    end
                end
            end
            load @site
            inc
            store @site
        end
        if @top != 0
            push 0
            return
        end
        load @plan
        push 0
        load @site
        call TemporalCellSet
        push 1
        return
    }

    func TemporalResolveBreaks(t_uint64 length,t_uint64 plan) -> t_uint64
    {
        local
        {
            t_uint64 pc 0 t_uint64 row 0 t_uint64 op 0 t_uint64 scope 0
        }
        // Resolve forward BREAK destinations now that all scopes have closed.
        push 0
        store @pc
        while @pc < @length
            load @plan
            load @pc
            call TemporalPlanRow
            store @row
            load @row
            push 0
            call TemporalPlanGet
            store @op
            if @op == 7
                load @plan
                load @row
                push 3
                call TemporalPlanGet
                dec
                call TemporalPlanRow
                store @scope
                load @row
                push 2
                load @scope
                push 7
                call TemporalPlanGet
                call TemporalPlanSet
            end
            load @row
            push 1
            call TemporalPlanGet
            store @pc
        end
        push 1
        return
    }

    func TemporalAnalyzeDepth(t_uint64 length,t_uint64 capacity,t_uint64 plan) -> t_uint64
    {
        local
        {
            t_uint64 work 0 t_uint64 row 0 t_uint64 head 0 t_uint64 tail 0
            t_uint64 site 0 t_uint64 op 0 t_uint64 next 0 t_uint64 target 0 t_uint64 depth 0 t_uint64 shape 0
        }
        // Reachability and exact stack-depth dataflow. Each site is queued at most once.
        load @plan
        load @length
        call TemporalPlanRow
        store @work
        load @plan
        push 0
        call TemporalPlanRow
        store @row
        load @row
        push 5
        push 1
        call TemporalPlanSet
        load @work
        push 0
        store t_uint16
        push 1
        store @tail
        while @head < @tail
            load @work
            load @head
            push 2
            mul
            add
            load t_uint16
            store @site
            load @head
            inc
            store @head
            load @plan
            load @site
            call TemporalPlanRow
            store @row
            load @row
            push 0
            call TemporalPlanGet
            store @op
            load @row
            push 1
            call TemporalPlanGet
            store @next
            load @row
            push 2
            call TemporalPlanGet
            store @target
            load @row
            push 5
            call TemporalPlanGet
            dec
            store @depth
            if @op == 9
                if @depth == 0
                    push 0
                    return
                end
            else
                if @op == 0
                else
                    load @op
                    push 4
                    eq
                    load @op
                    push 12
                    eq
                    or
                    if
                        if @depth == 0
                            push 0
                            return
                        end
                        load @depth
                        dec
                        store @depth
                        // Conditional false edge; true edge is enqueued below.
                        load @plan
                        load @work
                        load @length
                        load @tail
                        load @target
                        load @depth
                        call TemporalPlanEdge
                        store @tail
                        if @tail == 0
                            push 0
                            return
                        end
                        load @tail
                        dec
                        store @tail
                    else
                        load @op
                        push 5
                        eq
                        load @op
                        push 6
                        eq
                        or
                        load @op
                        push 7
                        eq
                        or
                        load @op
                        push 8
                        eq
                        or
                        if
                            load @target
                            store @next
                        else
                            load @op
                            push 1
                            eq
                            load @op
                            push 2
                            eq
                            or
                            load @op
                            push 3
                            eq
                            or
                            if
                            else
                                if @op == 17
                                    load @depth
                                    inc
                                    store @depth
                                    load @depth
                                    load @capacity
                                    ugt
                                    if
                                        push 0
                                        return
                                    end
                                else
                                    load @op
                                    load @row
                                    push 6
                                    call TemporalPlanGet
                                    load @depth
                                    load @capacity
                                    call TemporalPrivateDepth
                                    store @shape
                                    if @shape == 0
                                        push 0
                                        return
                                    end
                                    load @shape
                                    dec
                                    store @depth
                                end
                            end
                        end
                    end
                    load @plan
                    load @work
                    load @length
                    load @tail
                    load @next
                    load @depth
                    call TemporalPlanEdge
                    store @tail
                    if @tail == 0
                        push 0
                        return
                    end
                    load @tail
                    dec
                    store @tail
                end
            end
        end
        push 1
        return
    }

    func TemporalValidateTransfers(t_uint64 length,t_uint64 plan) -> t_uint64
    {
        local
        {
            t_uint64 pc 0 t_uint64 row 0 t_uint64 op 0 t_uint64 depth 0 t_uint64 scope 0 t_uint64 shape 0 t_uint64 kind 0
        }
        // Match portable BREAK/CONTINUE entry-depth constraints, not merely graph joins.
        push 0
        store @pc
        while @pc < @length
            load @plan
            load @pc
            call TemporalPlanRow
            store @row
            load @row
            push 0
            call TemporalPlanGet
            store @op
            load @op
            push 7
            eq
            load @op
            push 8
            eq
            or
            if
                load @row
                push 5
                call TemporalPlanGet
                store @depth
                if @depth != 0
                    load @plan
                    load @row
                    push 3
                    call TemporalPlanGet
                    dec
                    call TemporalPlanRow
                    store @scope
                    load @scope
                    push 5
                    call TemporalPlanGet
                    store @shape
                    load @scope
                    push 0
                    call TemporalPlanGet
                    store @kind
                    if @kind == 12
                        if @op == 7
                            load @shape
                            dec
                            store @shape
                        end
                    end
                    load @depth
                    load @shape
                    neq
                    if
                        push 0
                        return
                    end
                end
            end
            load @row
            push 1
            call TemporalPlanGet
            store @pc
        end
        push 1
        return
    }

    // Internal typed cell abstraction. Addresses never originate in guest cells.
    func TemporalCellAddress(t_uint64 address,t_uint64 index) -> t_uint64
    {
        load @address
        load @index
        block (t_uint64,t_uint64) -> t_uint64
            push 8
            mul
            add
        end
        return
    }

    func TemporalCellGet(t_uint64 address,t_uint64 index) -> t_uint64
    {
        load @address
        load @index
        call TemporalCellAddress
        load t_uint64
        return
    }

    func TemporalCellSet(t_uint64 address,t_uint64 index,t_uint64 value) -> t_void
    {
        load @address
        load @index
        call TemporalCellAddress
        load @value
        store t_uint64
        return
    }

    func TemporalPlanRow(t_uint64 plan,t_uint64 site) -> t_uint64
    {
        load @plan
        push 8
        add
        load @site
        push 24
        mul
        add
        return
    }

    func TemporalCondition(t_uint64 cells,t_uint64 depth) -> t_uint64
    {
        load @cells
        load @depth
        dec
        call TemporalCellGet
        return
    }

    // State layout: PC, depth, fuel, phase, last site, result, sequence, clock.
    // Phase changes and boundary snapshots have one implementation.
    func TemporalSetPhase(t_uint64 state,t_uint64 phase,t_uint64 boundary) -> t_uint64
    {
        load @state
        push 3
        load @phase
        call TemporalCellSet
        load @boundary
        return
    }

    func TemporalFail(t_uint64 state) -> t_uint64
    {
        load @state
        push 6
        push 6
        call TemporalSetPhase
        return
    }

    func TemporalSaveBoundary(t_uint64 state,t_uint64 pc,t_uint64 depth,t_uint64 fuel,t_uint64 site,t_uint64 kind) -> t_uint64
    {
        load @state
        push 0
        load @pc
        call TemporalCellSet
        load @state
        push 1
        load @depth
        call TemporalCellSet
        load @state
        push 2
        load @fuel
        call TemporalCellSet
        load @state
        push 4
        load @site
        call TemporalCellSet
        load @state
        load @kind
        load @kind
        call TemporalSetPhase
        return
    }

    // Bounded little-endian decode, used only after the planner validates length.
    func TemporalReadImmediate(t_uint64 bytes,t_uint64 length) -> t_uint64
    {
        local
        {
            t_uint64 value 0
            t_uint64 i 0
        }
        while @i < @length
            load @bytes
            load @i
            add
            load t_byte
            load @i
            push 8
            mul
            shl
            load @value
            or
            store @value
            load @i
            inc
            store @i
        end
        load @value
        return
    }

    // Stack indices are top-relative; cell indices are bottom-relative.
    func TemporalStackGet(t_uint64 cells,t_uint64 depth,t_uint64 index) -> t_uint64
    {
        load @cells
        load @depth
        dec
        load @index
        sub
        call TemporalCellGet
        return
    }

    func TemporalPick(t_uint64 cells,t_uint64 depth,t_uint64 index) -> t_void
    {
        load @cells
        load @depth
        load @cells
        load @depth
        load @index
        call TemporalStackGet
        call TemporalCellSet
        return
    }

    func TemporalRemove(t_uint64 cells,t_uint64 depth,t_uint64 index) -> t_void
    {
        local
        {
            t_uint64 pos 0 t_uint64 last 0
        }
        load @depth
        dec
        store @last
        load @last
        load @index
        sub
        store @pos
        while @pos < @last
            load @cells
            load @pos
            load @cells
            load @pos
            inc
            call TemporalCellGet
            call TemporalCellSet
            load @pos
            inc
            store @pos
        end
        return
    }

    func TemporalRotate(t_uint64 cells,t_uint64 depth,t_uint64 span,t_uint64 count) -> t_void
    {
        local
        {
            t_uint64 i 0 t_uint64 value 0
        }
        while @i < @count
            load @cells
            load @depth
            load @span
            dec
            call TemporalStackGet
            store @value
            load @cells
            load @depth
            load @span
            dec
            call TemporalRemove
            load @cells
            load @depth
            dec
            load @value
            call TemporalCellSet
            load @i
            inc
            store @i
        end
        return
    }

    func TemporalCopyPair(t_uint64 cells,t_uint64 depth,t_uint64 span) -> t_void
    {
        load @cells
        load @depth
        load @span
        dec
        call TemporalPick
        load @cells
        load @depth
        inc
        load @span
        dec
        call TemporalPick
        return
    }

    func TemporalStackByte(t_uint64 cells,t_uint64 depth,t_uint64 offset) -> t_uint64
    {
        load @cells
        load @depth
        load @offset
        push 8
        udiv
        call TemporalStackGet
        load @offset
        push 8
        umod
        push 8
        mul
        lshr
        push 255
        and
        return
    }

    func TemporalStackWord(t_uint64 cells,t_uint64 depth,t_uint64 offset) -> t_uint64
    {
        load @cells
        load @depth
        load @offset
        call TemporalStackByte
        load @cells
        load @depth
        load @offset
        inc
        call TemporalStackByte
        block (t_uint64,t_uint64) -> t_uint64
            push 8
            shl
            or
        end
        return
    }

    func TemporalIsUnary(t_uint64 op) -> t_uint64
    {
        load @op
        push 37
        uge
        load @op
        push 40
        ule
        and
        load @op
        push 51
        eq
        or
        return
    }

    func TemporalArithmeticSafe(t_uint64 op,t_uint64 lhs,t_uint64 rhs) -> t_uint64
    {
        load @op
        push 35
        eq
        load @op
        push 36
        eq
        or
        if
            if @rhs == 0
                push 0
                return
            end
            load @lhs
            push 1
            push 63
            shl
            eq
            load @rhs
            push 0
            not
            eq
            and
            if
                push 0
                return
            end
        end
        load @op
        push 41
        eq
        load @op
        push 42
        eq
        or
        if
            if @rhs == 0
                push 0
                return
            end
        end
        push 1
        return
    }

    func TemporalUnary(t_uint64 op,t_uint64 value) -> t_uint64
    {
        load @op
        switch
            branch 37
                load @value
                inc
                return
            end
            branch 38
                load @value
                dec
                return
            end
            branch 39
                load @value
                neg
                return
            end
            branch 40
                load @value
                abs
                return
            end
            branch 51
                load @value
                not
                return
            end
            default
                trap
        end
    }

    // Opcode registry values are localized here. Each branch implements exactly
    // one cell transformation; the caller owns admission, fuel and fault checks.
    func TemporalBinary(t_uint64 op,t_uint64 lhs,t_uint64 rhs) -> t_uint64
    {
        load @op
        switch
            branch 32
                load @lhs
                load @rhs
                add
                return
            end
            branch 33
                load @lhs
                load @rhs
                sub
                return
            end
            branch 34
                load @lhs
                load @rhs
                mul
                return
            end
            branch 35
                load @lhs
                load @rhs
                div
                return
            end
            branch 36
                load @lhs
                load @rhs
                mod
                return
            end
            branch 41
                load @lhs
                load @rhs
                udiv
                return
            end
            branch 42
                load @lhs
                load @rhs
                umod
                return
            end
            branch 48
                load @lhs
                load @rhs
                and
                return
            end
            branch 49
                load @lhs
                load @rhs
                or
                return
            end
            branch 50
                load @lhs
                load @rhs
                xor
                return
            end
            branch 52
                load @lhs
                load @rhs
                shl
                return
            end
            branch 53
                load @lhs
                load @rhs
                shr
                return
            end
            branch 54
                load @lhs
                load @rhs
                lshr
                return
            end
            branch 64
                load @lhs
                load @rhs
                eq
                return
            end
            branch 65
                load @lhs
                load @rhs
                neq
                return
            end
            branch 66
                load @lhs
                load @rhs
                lt
                return
            end
            branch 67
                load @lhs
                load @rhs
                le
                return
            end
            branch 68
                load @lhs
                load @rhs
                gt
                return
            end
            branch 69
                load @lhs
                load @rhs
                ge
                return
            end
            branch 70
                load @lhs
                load @rhs
                ult
                return
            end
            branch 71
                load @lhs
                load @rhs
                ule
                return
            end
            branch 72
                load @lhs
                load @rhs
                ugt
                return
            end
            branch 73
                load @lhs
                load @rhs
                uge
                return
            end
            default
                trap
        end
    }

    // The scheduler only sees an immutable admitted plan, never guest Code.
    func TemporalRunPrepared(t_uint64 states,t_uint64 stacks,t_uint64 contexts,t_uint64 capacity,t_uint64 quantum,t_uint64 ledger,t_uint64 limit,t_uint64 plan) -> t_uint64
    {
        local
        {
            t_uint64 round 0 t_uint64 commit 0 t_uint64 i 0 t_uint64 live 0
            t_uint64 state 0 t_uint64 cells 0 t_uint64 row 0 t_uint64 kind 0
            t_uint64 seq 0 t_uint64 logical 0 t_uint64 site 0 t_uint64 result 0
            t_uint64 fuel 0 t_uint64 j 0 t_uint64 instructionCount 0
        }
        if @contexts == 0
            push 0
            return
        end
        load @contexts
        push 128
        ugt
        if
            push 0
            return
        end
        if @capacity == 0
            push 0
            return
        end
        load @capacity
        push 4096
        ugt
        if
            push 0
            return
        end
        if @quantum == 0
            push 0
            return
        end
        load @limit
        push 1000000
        ugt
        if
            push 0
            return
        end
        load @contexts
        load @limit
        ugt
        if
            push 0
            return
        end

        load @plan
        push 0
        call TemporalCellGet
        store @instructionCount
        // Initial admissions, round zero.
        while @i < @contexts
            load @states
            load @i
            call TemporalContextRow
            store @state
            push 0
            store @j
            while @j < 8
                load @state
                load @j
                push 0
                call TemporalCellSet
                load @j
                inc
                store @j
            end
            load @state
            push 7
            load @i
            inc
            call TemporalCellSet
            load @ledger
            load @commit
            call TemporalLedgerRow
            load @round
            push 0
            load @commit
            inc
            dup
            dup
            push 7
            push 0
            push 4294967295
            load @i
            inc
            call TemporalLedgerWrite
            load @commit
            inc
            store @commit
            load @i
            inc
            store @i
        end
        load @contexts
        store @live
        loop
            if @live == 0
                load @commit
                return
            end
            load @round
            inc
            store @round
            push 0
            store @i
            while @i < @contexts
                load @states
                load @i
                call TemporalContextRow
                store @state
                load @state
                push 3
                call TemporalCellGet
                push 5
                neq
                if
                    if @commit == @limit
                        push 0
                        return
                    end
                    load @stacks
                    load @i
                    load @capacity
                    mul
                    call TemporalCellAddress
                    store @cells
                    load @instructionCount
                    load @state
                    load @cells
                    load @capacity
                    load @quantum
                    load @plan
                    call TemporalTurn
                    store @kind
                    if @kind == 6
                        push 0
                        return
                    end
                    if @kind == 5
                        load @live
                        dec
                        store @live
                    end
                    load @state
                    push 6
                    call TemporalCellGet
                    inc
                    store @seq
                    load @state
                    push 7
                    call TemporalCellGet
                    inc
                    store @logical
                    load @state
                    push 6
                    load @seq
                    call TemporalCellSet
                    load @state
                    push 7
                    load @logical
                    call TemporalCellSet
                    load @state
                    push 2
                    call TemporalCellGet
                    store @fuel
                    push 4294967295
                    store @site
                    if @kind > 0
                        if @kind < 4
                            load @state
                            push 4
                            call TemporalCellGet
                            store @site
                        end
                    end
                    push 0
                    store @result
                    if @kind == 2
                        load @state
                        push 5
                        call TemporalCellGet
                        store @result
                    end
                    load @ledger
                    load @commit
                    call TemporalLedgerRow
                    load @round
                    load @i
                    inc
                    load @seq
                    load @logical
                    load @commit
                    inc
                    load @kind
                    load @fuel
                    load @site
                    load @result
                    call TemporalLedgerWrite
                    load @commit
                    inc
                    store @commit
                end
                load @i
                inc
                store @i
            end
        end
    }

    func TemporalLedgerRow(t_uint64 ledger,t_uint64 ordinal) -> t_uint64
    {
        load @ledger
        load @ordinal
        push 72
        mul
        add
        return
    }

    // The event projection is written in a single place for all boundary kinds.
    func TemporalLedgerWrite(t_uint64 row,t_uint64 round,t_uint64 context,t_uint64 seq,t_uint64 logical,t_uint64 commit,t_uint64 kind,t_uint64 fuel,t_uint64 site,t_uint64 result) -> t_void
    {
        load @row
        push 0
        load @round
        call TemporalCellSet
        load @row
        push 1
        load @context
        call TemporalCellSet
        load @row
        push 2
        load @seq
        call TemporalCellSet
        load @row
        push 3
        load @logical
        call TemporalCellSet
        load @row
        push 4
        load @commit
        call TemporalCellSet
        load @row
        push 5
        load @kind
        call TemporalCellSet
        load @row
        push 6
        load @fuel
        call TemporalCellSet
        load @row
        push 7
        load @site
        call TemporalCellSet
        load @row
        push 8
        load @result
        call TemporalCellSet
        return
    }

    // Context records and instruction records have independent layouts,
    // even though their bootstrap strides happen to be equal.
    func TemporalContextRow(t_uint64 states,t_uint64 ordinal) -> t_uint64
    {
        load @states
        load @ordinal
        push 64
        mul
        add
        return
    }

    // Logical fields 0..5 are u16; field 6 is the u64 operand;
    // fields 7/8 are u16 scope exit and original wire offset.
    func TemporalPlanField(t_uint64 row,t_uint64 fieldIndex) -> t_uint64
    {
        if @fieldIndex == 6
            load @row
            push 16
            add
            return
        end
        if @fieldIndex > 6
            load @row
            load @fieldIndex
            dec
            push 2
            mul
            add
            return
        end
        load @row
        load @fieldIndex
        push 2
        mul
        add
        return
    }

    func TemporalPlanGet(t_uint64 row,t_uint64 fieldIndex) -> t_uint64
    {
        load @row
        load @fieldIndex
        call TemporalPlanField
        if @fieldIndex == 6
            load t_uint64
            return
        end
        load t_uint16
        return
    }

    func TemporalPlanSet(t_uint64 row,t_uint64 fieldIndex,t_uint64 value) -> t_void
    {
        load @row
        load @fieldIndex
        call TemporalPlanField
        load @value
        if @fieldIndex == 6
            store t_uint64
            return
        end
        store t_uint16
        return
    }

    func TemporalPlanOrdinal(t_uint64 row,t_uint64 plan) -> t_uint64
    {
        load @row
        load @plan
        sub
        push 8
        sub
        push 24
        udiv
        return
    }
}
