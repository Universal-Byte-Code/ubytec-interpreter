module (name:"temporal_runtime",version:"0.1",author:"Ubytec")
{
    // Bootstrap native library. Code is the exact admitted UBCM function bytes.
    // State: pc, depth, fuel, phase, last site, result (six u64 cells).
    // Phase: 0 enter, 1 runnable, 2 returned, 3 trapped, 4 aborted,
    // 5 terminated, 6 infrastructure failure. Boundary values mirror phase
    // except 1=budget. No guest pointer is ever interpreted as a host address.
    // Caller owns disjoint code/state/stack buffers and admits a verified
    // zero-argument Int64 straight-line function. No full PMF verifier yet.
    func TemporalTurn(t_uint64 code,t_uint64 length,t_uint64 state,t_uint64 cells,t_uint64 capacity,t_uint64 quantum) -> t_uint64
    {
        local
        {
            t_uint64 pc 0 t_uint64 depth 0 t_uint64 fuel 0 t_uint64 phase 0
            t_uint64 site 0 t_uint64 charged 0 t_uint64 op 0 t_uint64 n 0
            t_uint64 i 0 t_uint64 value 0 t_uint64 lhs 0 t_uint64 rhs 0
        }
        if @quantum == 0
            push 6
            return
        end
        load @capacity
        push 4096
        ugt
        if
            push 6
            return
        end
        load @state
        push 24
        add
        load t_uint64
        store @phase
        if @phase == 0
            load @state
            push 24
            add
            push 1
            store t_uint64
            push 0
            return
        end
        if @phase == 2
            load @state
            push 24
            add
            push 5
            store t_uint64
            push 5
            return
        end
        if @phase == 3
            load @state
            push 24
            add
            push 4
            store t_uint64
            push 4
            return
        end
        if @phase == 4
            load @state
            push 24
            add
            push 5
            store t_uint64
            push 5
            return
        end
        if @phase != 1
            push 6
            return
        end
        load @state
        push 0
        add
        load t_uint64
        store @pc
        load @state
        push 8
        add
        load t_uint64
        store @depth
        load @state
        push 16
        add
        load t_uint64
        store @fuel
        load @depth
        load @capacity
        ugt
        if
            load @state
            push 24
            add
            push 6
            store t_uint64
            push 6
            return
        end
        loop
            load @pc
            load @length
            uge
            if
                load @state
                push 24
                add
                push 6
                store t_uint64
                push 6
                return
            end
            load @fuel
            push 1
            add
            if
            else
                load @state
                push 24
                add
                push 6
                store t_uint64
                push 6
                return
            end
            load @pc
            store @site
            load @code
            load @pc
            add
            load t_byte
            store @op
            load @pc
            inc
            store @pc
            load @fuel
            inc
            store @fuel
            load @charged
            inc
            store @charged
            // TRAP: attempted guest opcode, not a trap in the host runtime.
            if @op == 0
                load @state
                push 0
                add
                load @pc
                store t_uint64
                load @state
                push 8
                add
                load @depth
                store t_uint64
                load @state
                push 16
                add
                load @fuel
                store t_uint64
                load @state
                push 24
                add
                push 3
                store t_uint64
                load @state
                push 32
                add
                load @site
                store t_uint64
                push 3
                return
            end
            // NOP
            if @op == 1
            else
                // PUSH: canonical zero-extended little endian 1..8 bytes.
                if @op == 17
                    load @pc
                    load @length
                    uge
                    if
                        load @state
                        push 24
                        add
                        push 6
                        store t_uint64
                        push 6
                        return
                    end
                    load @code
                    load @pc
                    add
                    load t_byte
                    store @n
                    load @pc
                    inc
                    store @pc
                    if @n == 0
                        load @state
                        push 24
                        add
                        push 6
                        store t_uint64
                        push 6
                        return
                    end
                    if @n > 8
                        load @state
                        push 24
                        add
                        push 6
                        store t_uint64
                        push 6
                        return
                    end
                    load @n
                    load @length
                    load @pc
                    sub
                    ugt
                    if
                        load @state
                        push 24
                        add
                        push 6
                        store t_uint64
                        push 6
                        return
                    end
                    load @depth
                    load @capacity
                    uge
                    if
                        load @state
                        push 24
                        add
                        push 6
                        store t_uint64
                        push 6
                        return
                    end
                    push 0
                    store @value
                    push 0
                    store @i
                    while @i < @n
                        load @code
                        load @pc
                        add
                        load @i
                        add
                        load t_byte
                        load @i
                        push 8
                        mul
                        shl
                        load @value
                        or
                        store @value
                        load @i
                        inc
                        store @i
                    end
                    load @pc
                    load @n
                    add
                    store @pc
                    load @cells
                    load @depth
                    push 8
                    mul
                    add
                    load @value
                    store t_uint64
                    load @depth
                    inc
                    store @depth
                else
                    // ADD: modulo 2^64, only private guest cells.
                    if @op == 32
                        if @depth < 2
                            load @state
                            push 24
                            add
                            push 6
                            store t_uint64
                            push 6
                            return
                        end
                        load @depth
                        dec
                        store @depth
                        load @cells
                        load @depth
                        push 8
                        mul
                        add
                        load t_uint64
                        store @rhs
                        load @cells
                        load @depth
                        dec
                        push 8
                        mul
                        add
                        load t_uint64
                        store @lhs
                        load @cells
                        load @depth
                        dec
                        push 8
                        mul
                        add
                        load @lhs
                        load @rhs
                        add
                        store t_uint64
                    else
                        // RETURN inferred type only. Root is admitted Int64.
                        if @op == 9
                            load @pc
                            load @length
                            uge
                            if
                                load @state
                                push 24
                                add
                                push 6
                                store t_uint64
                                push 6
                                return
                            end
                            load @code
                            load @pc
                            add
                            load t_byte
                            if
                                load @state
                                push 24
                                add
                                push 6
                                store t_uint64
                                push 6
                                return
                            end
                            if @depth == 0
                                load @state
                                push 24
                                add
                                push 6
                                store t_uint64
                                push 6
                                return
                            end
                            load @pc
                            inc
                            store @pc
                            load @depth
                            dec
                            store @depth
                            load @state
                            push 40
                            add
                            load @cells
                            load @depth
                            push 8
                            mul
                            add
                            load t_uint64
                            store t_uint64
                            load @state
                            push 0
                            add
                            load @pc
                            store t_uint64
                            load @state
                            push 8
                            add
                            load @depth
                            store t_uint64
                            load @state
                            push 16
                            add
                            load @fuel
                            store t_uint64
                            load @state
                            push 24
                            add
                            push 2
                            store t_uint64
                            load @state
                            push 32
                            add
                            load @site
                            store t_uint64
                            push 2
                            return
                        else
                            // Unsupported/malformed code is not a guest trap.
                            load @state
                            push 24
                            add
                            push 6
                            store t_uint64
                            push 6
                            return
                        end
                    end
                end
            end
            if @charged == @quantum
                load @state
                push 0
                add
                load @pc
                store t_uint64
                load @state
                push 8
                add
                load @depth
                store t_uint64
                load @state
                push 16
                add
                load @fuel
                store t_uint64
                load @state
                push 24
                add
                push 1
                store t_uint64
                load @state
                push 32
                add
                load @site
                store t_uint64
                push 1
                return
            end
        end
    }

    // Serial reference scheduler. Each context occupies eight cells (six state
    // fields plus local sequence and Lamport clock). Ledger row has nine cells:
    // round, context ordinal, sequence, logical time, commit, kind, fuel,
    // last instruction offset (NoIndex for synthetic boundaries), result.
    // Kind 7 is coordinator context creation. Initial creation causality makes
    // context i's first logical clock i+1. Return 0 means infrastructure failure.
    // The host supplies non-overlapping sized buffers; no guest physical addresses.
    func TemporalRun(t_uint64 code,t_uint64 length,t_uint64 states,t_uint64 stacks,t_uint64 contexts,t_uint64 capacity,t_uint64 quantum,t_uint64 ledger,t_uint64 limit) -> t_uint64
    {
        local
        {
            t_uint64 round 0 t_uint64 commit 0 t_uint64 i 0 t_uint64 live 0
            t_uint64 state 0 t_uint64 cells 0 t_uint64 row 0 t_uint64 kind 0
            t_uint64 seq 0 t_uint64 logical 0 t_uint64 site 0 t_uint64 result 0
            t_uint64 fuel 0 t_uint64 j 0
        }
        if @contexts == 0
            push 0
            return
        end
        load @contexts
        push 128
        ugt
        if
            push 0
            return
        end
        if @capacity == 0
            push 0
            return
        end
        load @capacity
        push 4096
        ugt
        if
            push 0
            return
        end
        if @quantum == 0
            push 0
            return
        end
        load @limit
        push 1000000
        ugt
        if
            push 0
            return
        end
        load @contexts
        load @limit
        ugt
        if
            push 0
            return
        end
        // Establish initial admission and creation events in ordinal order.
        while @i < @contexts
            load @states
            load @i
            push 64
            mul
            add
            store @state
            push 0
            store @j
            while @j < 8
                load @state
                load @j
                push 8
                mul
                add
                push 0
                store t_uint64
                load @j
                inc
                store @j
            end
            load @state
            push 56
            add
            load @i
            inc
            store t_uint64
            load @ledger
            load @commit
            push 72
            mul
            add
            store @row
            load @commit
            inc
            store @commit
            load @row
            push 0
            add
            load @round
            store t_uint64
            load @row
            push 8
            add
            push 0
            store t_uint64
            load @row
            push 16
            add
            load @commit
            store t_uint64
            load @row
            push 24
            add
            load @commit
            store t_uint64
            load @row
            push 32
            add
            load @commit
            store t_uint64
            load @row
            push 40
            add
            push 7
            store t_uint64
            load @row
            push 48
            add
            push 0
            store t_uint64
            load @row
            push 56
            add
            push 4294967295
            store t_uint64
            load @row
            push 64
            add
            load @i
            inc
            store t_uint64
            load @i
            inc
            store @i
        end
        load @contexts
        store @live
        loop
            if @live == 0
                load @commit
                return
            end
            load @round
            inc
            store @round
            push 0
            store @i
            while @i < @contexts
                load @states
                load @i
                push 64
                mul
                add
                store @state
                load @state
                push 24
                add
                load t_uint64
                push 5
                neq
                if
                    if @commit == @limit
                        push 0
                        return
                    end
                    load @stacks
                    load @i
                    load @capacity
                    mul
                    push 8
                    mul
                    add
                    store @cells
                    load @code
                    load @length
                    load @state
                    load @cells
                    load @capacity
                    load @quantum
                    call TemporalTurn
                    store @kind
                    if @kind == 6
                        push 0
                        return
                    end
                    if @kind == 5
                        load @live
                        dec
                        store @live
                    end
                    load @state
                    push 48
                    add
                    load t_uint64
                    inc
                    store @seq
                    load @state
                    push 56
                    add
                    load t_uint64
                    inc
                    store @logical
                    load @state
                    push 48
                    add
                    load @seq
                    store t_uint64
                    load @state
                    push 56
                    add
                    load @logical
                    store t_uint64
                    load @state
                    push 16
                    add
                    load t_uint64
                    store @fuel
                    push 4294967295
                    store @site
                    if @kind > 0
                        if @kind < 4
                            load @state
                            push 32
                            add
                            load t_uint64
                            store @site
                        end
                    end
                    push 0
                    store @result
                    if @kind == 2
                        load @state
                        push 40
                        add
                        load t_uint64
                        store @result
                    end
                    load @ledger
                    load @commit
                    push 72
                    mul
                    add
                    store @row
                    load @commit
                    inc
                    store @commit
                    load @row
                    push 0
                    add
                    load @round
                    store t_uint64
                    load @row
                    push 8
                    add
                    load @i
                    inc
                    store t_uint64
                    load @row
                    push 16
                    add
                    load @seq
                    store t_uint64
                    load @row
                    push 24
                    add
                    load @logical
                    store t_uint64
                    load @row
                    push 32
                    add
                    load @commit
                    store t_uint64
                    load @row
                    push 40
                    add
                    load @kind
                    store t_uint64
                    load @row
                    push 48
                    add
                    load @fuel
                    store t_uint64
                    load @row
                    push 56
                    add
                    load @site
                    store t_uint64
                    load @row
                    push 64
                    add
                    load @result
                    store t_uint64
                end
                load @i
                inc
                store @i
            end
        end
    }
}
